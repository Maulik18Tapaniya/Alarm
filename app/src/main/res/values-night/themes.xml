<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Alarm" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize dark theme. -->
        <item name="colorPrimary">@color/primary_indigo_light</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/primary_indigo_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/primary_indigo_light</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
    </style>
</resources>
