<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addEditCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/new_alarm"
            app:titleTextColor="?attr/colorOnSurface">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/_12sdp"
                android:text="@string/save"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart" />
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_16sdp">

            <!-- Time Display Card (Clickable to open TimePicker) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTimePicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/_24sdp"
                    android:paddingHorizontal="@dimen/_16sdp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDisplayTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textSize="@dimen/_48ssp"
                            android:textStyle="bold"
                            tools:text="07:30" />

                        <TextView
                            android:id="@+id/tvDisplayAmPm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textSize="@dimen/_16ssp"
                            tools:text="AM" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCountdownPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/_12ssp"
                        tools:text="Alarm in 8 hours 25 minutes" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Repeat Days Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorSurfaceVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_16sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/repeat"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/_13ssp" />

                    <TextView
                        android:id="@+id/tvRepeatSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/_11ssp"
                        tools:text="Mon - Fri" />

                    <!-- Day Selector Buttons (Mon to Sun) -->
                    <LinearLayout
                        android:id="@+id/layoutDays"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <!-- Monday -->
                        <TextView
                            android:id="@+id/btnDayMon"
                            android:layout_width="@dimen/_32sdp"
                            android:layout_height="@dimen/_32sdp"
                            android:layout_marginHorizontal="@dimen/_3sdp"
                            android:background="@drawable/bg_day_chip_selector"
                            android:gravity="center"
                            android:text="M"
                            android:textColor="@color/day_chip_text_color"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />

                        <!-- Tuesday -->
                        <TextView
                            android:id="@+id/btnDayTue"
                            android:layout_width="@dimen/_32sdp"
                            android:layout_height="@dimen/_32sdp"
                            android:layout_marginHorizontal="@dimen/_3sdp"
                            android:background="@drawable/bg_day_chip_selector"
                            android:gravity="center"
                            android:text="T"
                            android:textColor="@color/day_chip_text_color"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />

                        <!-- Wednesday -->
                        <TextView
                            android:id="@+id/btnDayWed"
                            android:layout_width="@dimen/_32sdp"
                            android:layout_height="@dimen/_32sdp"
                            android:layout_marginHorizontal="@dimen/_3sdp"
                            android:background="@drawable/bg_day_chip_selector"
                            android:gravity="center"
                            android:text="W"
                            android:textColor="@color/day_chip_text_color"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />

                        <!-- Thursday -->
                        <TextView
                            android:id="@+id/btnDayThu"
                            android:layout_width="@dimen/_32sdp"
                            android:layout_height="@dimen/_32sdp"
                            android:layout_marginHorizontal="@dimen/_3sdp"
                            android:background="@drawable/bg_day_chip_selector"
                            android:gravity="center"
                            android:text="T"
                            android:textColor="@color/day_chip_text_color"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />

                        <!-- Friday -->
                        <TextView
                            android:id="@+id/btnDayFri"
                            android:layout_width="@dimen/_32sdp"
                            android:layout_height="@dimen/_32sdp"
                            android:layout_marginHorizontal="@dimen/_3sdp"
                            android:background="@drawable/bg_day_chip_selector"
                            android:gravity="center"
                            android:text="F"
                            android:textColor="@color/day_chip_text_color"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />

                        <!-- Saturday -->
                        <TextView
                            android:id="@+id/btnDaySat"
                            android:layout_width="@dimen/_32sdp"
                            android:layout_height="@dimen/_32sdp"
                            android:layout_marginHorizontal="@dimen/_3sdp"
                            android:background="@drawable/bg_day_chip_selector"
                            android:gravity="center"
                            android:text="S"
                            android:textColor="@color/day_chip_text_color"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />

                        <!-- Sunday -->
                        <TextView
                            android:id="@+id/btnDaySun"
                            android:layout_width="@dimen/_32sdp"
                            android:layout_height="@dimen/_32sdp"
                            android:layout_marginHorizontal="@dimen/_3sdp"
                            android:background="@drawable/bg_day_chip_selector"
                            android:gravity="center"
                            android:text="S"
                            android:textColor="@color/day_chip_text_color"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Date Picker row for One-Time Alarms -->
                    <LinearLayout
                        android:id="@+id/layoutDatePicker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_16sdp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/_6sdp">

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:contentDescription="@string/date"
                            android:src="@drawable/ic_calendar"
                            app:tint="?attr/colorPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/date"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="@dimen/_12ssp" />

                            <TextView
                                android:id="@+id/tvSelectedDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="@dimen/_11ssp"
                                tools:text="Today" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickDate"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select Date" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Details Section (Label, Snooze, Vibrate) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorSurfaceVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_16sdp">

                    <!-- Title / Label Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTitle"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/label">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textCapSentences"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Snooze Duration Section -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_16sdp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/snooze_duration"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/_13ssp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupSnooze"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSnooze5"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/min_5" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSnooze10"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/min_10" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSnooze15"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/min_15" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSnooze30"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/min_30" />
                    </com.google.android.material.chip.ChipGroup>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/_12sdp"
                        android:background="?attr/colorSurfaceVariant" />

                    <!-- Vibrate Toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:contentDescription="@string/vibrate"
                            android:src="@drawable/ic_vibrate"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/vibrate"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/_13ssp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchVibrate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <!-- Enabled Toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:contentDescription="@string/enabled"
                            android:src="@drawable/ic_alarm"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/enabled"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/_13ssp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchEnabled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Delete Button (Shown only when editing an existing alarm) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_46sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_24sdp"
                android:text="@string/delete"
                android:textColor="@color/danger_rose"
                android:visibility="gone"
                app:cornerRadius="@dimen/_23sdp"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconTint="@color/danger_rose"
                app:strokeColor="@color/danger_rose"
                tools:visibility="visible" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
